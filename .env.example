# ============================================================================
# Zynqora — variables de entorno de EJEMPLO
# ============================================================================
# Copia este archivo a `.env` y rellena los valores.
# NUNCA subas `.env` a git (ya está en .gitignore).
# Las claves marcadas [SECRETO] NO deben aparecer nunca en el frontend.
# ============================================================================

# ---- FRONTEND (Expo / web) --------------------------------------------------
# Estas dos SÍ van en el frontend. La anon key es pública por diseño:
# lo que protege los datos es la RLS de Postgres, no ocultar esta clave.
EXPO_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJI...anon...

# URL de la Edge Function de IA (se calcula sola a partir de SUPABASE_URL,
# pero puedes fijarla si usas un dominio propio):
# EXPO_PUBLIC_AI_ENDPOINT=https://TU-PROYECTO.supabase.co/functions/v1/zynqora-ai


# ---- BACKEND: Supabase Secrets (Edge Functions) ---------------------------
# Se configuran con:  supabase secrets set NOMBRE=valor
# SUPABASE_URL y las dos SUPABASE_*_KEY las inyecta Supabase automáticamente
# en las Edge Functions; solo tienes que añadir la de Gemini y el origen.

# [SECRETO] Clave de Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=AIza...tu-clave-de-gemini...

# Origen permitido para CORS (la URL pública de tu app). "*" solo para pruebas.
ALLOWED_ORIGIN=https://tu-app.vercel.app

# Modelos (opcional — hay valores por defecto sensatos en _shared/gemini.ts)
# GEMINI_MODEL_CHAT=gemini-2.5-flash
# GEMINI_MODEL_REASONING=gemini-2.5-pro
# GEMINI_MODEL_DOCUMENTS=gemini-2.5-pro
# GEMINI_MODEL_EMBEDDING=text-embedding-004
# GEMINI_MODEL_TTS=gemini-2.5-flash-preview-tts


# ---- Inyectadas por Supabase (NO las pongas tú a mano en las funciones) ---
# SUPABASE_URL=...
# SUPABASE_ANON_KEY=...
# SUPABASE_SERVICE_ROLE_KEY=...   <- [SECRETO] se salta la RLS. Solo backend.


# ---- Pagos (FASE futura, no ahora) --------------------------------------
# STRIPE_SECRET_KEY=sk_live_...          # [SECRETO]
# STRIPE_WEBHOOK_SECRET=whsec_...        # [SECRETO]
# EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
